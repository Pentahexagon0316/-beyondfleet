# BeyondFleet environment template.
# Copy this file to .env.local for local development.
# Never commit real secrets or production credentials.

# Public Supabase browser client.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Public site URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Server-only Supabase access.
# Required for admin APIs, recommendations, brief generation, and sync jobs.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI generation and analysis.
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
CRON_SECRET=use_a_long_random_value

# Optional distributed rate limiting.
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Optional content, notification, and market data integrations.
WHALE_ALERT_API_KEY=
RESEND_API_KEY=

# Optional achievement/Web3 infrastructure.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
TREASURY_WALLET=
AUCTION_HOUSE_ADDRESS=
SELLER_FEE_BASIS_POINTS=250

# Supabase Edge Function compatibility.
SUPABASE_URL=https://your-project.supabase.co
